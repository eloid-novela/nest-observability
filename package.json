{
  "name": "nest-observability",
  "private": true,
  "description": "Observability toolkit for NestJS applications: structured logging, request context propagation and request tracing.",
  "license": "MIT",
  "author": "eloid-novela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloid-novela/nest-observability.git"
  },
  "workspaces": [
    "packages/core",
    "packages/nestjs"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w @nestjs-observability/core && npm run typecheck --workspaces",
    "test": "npm run test --workspaces -- --run",
    "test:coverage": "npm run test:coverage --workspaces",
    "lint": "eslint packages scripts",
    "dev": "node scripts/dev.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "@changesets/cli": "^2.27.0"
  },
  "engines": {
    "node": ">=20"
  }
}
